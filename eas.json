{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REEMPLAZAR_ASC_APP_ID",
        "appleId": "REEMPLAZAR_APPLE_ID"
      },
      "android": {
        "serviceAccountKeyPath": "REEMPLAZAR_RUTA_CLAVE_JSON",
        "track": "internal"
      }
    }
  }
}
