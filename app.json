{
  "expo": {
    "name": "mi-app",
    "slug": "mi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.camizoca.miapp",
      "associatedDomains": ["applinks:mymambo.app"]
    },
    "android": {
      "package": "com.camizoca.miapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mymambo.app",
              "pathPrefix": "/unirse"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mi Mambo necesita acceso a la cámara para escanear códigos QR de invitación a grupos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mi Mambo necesita acceso a tus fotos para subir fotos y videos a tus eventos y pasos.",
          "cameraPermission": "Mi Mambo necesita acceso a la cámara para tomar fotos y subirlas a tus eventos y pasos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73962dcd-cb7c-4b8f-9520-7db8704fb733"
      }
    },
    "owner": "camizoca"
  }
}
